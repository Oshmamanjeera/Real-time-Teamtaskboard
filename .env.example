# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Optional: Set DATABASE_URL to connect to an external PostgreSQL database.
# If omitted, the embedded PGlite engine runs automatically with local storage in ./data/pglite_db
DATABASE_URL=postgresql://your_db_user:your_db_password@your_db_host:5432/your_db_name
FORCE_PGLITE=false

# Authentication Secrets — replace with long random strings in production!
JWT_ACCESS_SECRET=your_jwt_access_secret_replace_me
JWT_REFRESH_SECRET=your_jwt_refresh_secret_replace_me
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
COOKIE_SECRET=your_cookie_secret_replace_me

# Client / CORS Configuration
CLIENT_ORIGIN=http://localhost:5173

