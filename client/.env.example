# Socket.IO server URL (development only — leave blank in production Vercel deployment)
# In production, Socket.IO connects directly to the Render backend via VITE_SOCKET_URL.
# In local dev, Vite's proxy handles /socket.io → localhost:5000, so leave VITE_SOCKET_URL unset
# or point it to your local server.
VITE_SOCKET_URL=http://localhost:5000

